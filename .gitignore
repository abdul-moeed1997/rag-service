# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Bundler
/.bundle
/vendor/bundle
/vendor/cache

# Environment files (keep the example)
/.env
/.env.*
!/.env.example

# Logs and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Pidfiles
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Storage (uploads and SQLite databases)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Credentials and keys
/config/*.key
/config/master.key
/config/credentials/*.key

# Compiled assets
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Test / coverage
/coverage
/spec/tmp
.rspec_status
.byebug_history

# Ruby / Rails tooling
/.ruby-lsp
.rake_tasks
.irb_history
.pry_history

# Editor and OS
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
