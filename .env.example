# Copy to .env and adjust as needed.
DATABASE_URL=postgres://rag_service:rag_service@localhost:5433/rag_service_development

# Embeddings: "fake", "openai", "voyage", or "local" (OpenAI-compatible HTTP)
# Schema is vector(1536). Changing dims requires a migration + reindex.
EMBEDDING_PROVIDER=fake
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3
EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
# Texts per provider request, and HTTP timeouts in seconds
EMBEDDING_BATCH_SIZE=64
EMBEDDING_OPEN_TIMEOUT=5
EMBEDDING_TIMEOUT=30
# Production refuses to boot with EMBEDDING_PROVIDER=fake unless this is "true"
# ALLOW_FAKE_EMBEDDINGS=true

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Documents list pagination
DOCUMENTS_DEFAULT_LIMIT=20
DOCUMENTS_MAX_LIMIT=100

# Rate limiting (per API key, fixed window of 60s)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging: "json" (default in production) or "text"
LOG_FORMAT=json
RAILS_LOG_LEVEL=info

# Operator endpoints (/api_keys). Required to mint, list, and revoke keys via API.
OPERATOR_API_KEY=
# Per-IP limit on operator endpoints; failed attempts count too
OPERATOR_RATE_LIMIT_PER_MINUTE=30

# Webhooks to private/loopback addresses are blocked. Set to true only for local development.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Encryption for tenant webhook secrets. Required in production
# (generate with `bin/rails db:encryption:init`); dev and test use built-in keys.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
