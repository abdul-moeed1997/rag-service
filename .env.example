# Copy to .env and adjust as needed.
DATABASE_URL=postgres://rag_service:rag_service@localhost:5433/rag_service_development

# Embeddings: "openai" or "fake" (deterministic vectors for local/dev without an API key)
EMBEDDING_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Operator endpoint (POST /api_keys). Required to mint keys via API.
OPERATOR_API_KEY=
