# Secrets for config/deploy.yml (registry/password, env/secret, accessories/*/env/secret).
# Pull from ENV or files — never paste raw credentials into this file.

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)

# GHCR: create a classic PAT (or fine-grained token) with write:packages / read:packages
#   export KAMAL_REGISTRY_PASSWORD=ghp_...
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?set KAMAL_REGISTRY_PASSWORD for ghcr.io}

# Postgres (accessory POSTGRES_PASSWORD must match app RAG_SERVICE_DATABASE_PASSWORD)
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
RAG_SERVICE_DATABASE_PASSWORD=${RAG_SERVICE_DATABASE_PASSWORD:-$POSTGRES_PASSWORD}

# Operator minting (POST /api_keys)
OPERATOR_API_KEY=${OPERATOR_API_KEY:?set OPERATOR_API_KEY}

# Active Record encryption (tenant webhook secrets). Generate once with
#   bin/rails db:encryption:init
# and keep them safe: losing them makes stored webhook secrets unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=${ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY:?set ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=${ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT:?set ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT}

# Embedding providers: the key for the provider named by EMBEDDING_PROVIDER in deploy.yml is required.
OPENAI_API_KEY=${OPENAI_API_KEY:-}
VOYAGE_API_KEY=${VOYAGE_API_KEY:-}
EMBEDDING_API_KEY=${EMBEDDING_API_KEY:-}
